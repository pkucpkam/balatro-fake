# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (Web).
# Leave empty to run local-only (no cloud save).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to use the local Firebase Emulator Suite instead of the real project
VITE_FIREBASE_EMULATOR=
